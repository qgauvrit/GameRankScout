{
  "name": "gamerankscout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ranks games by what communities are actually discussing, and surfaces the ones you have not heard of.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && eslint .",
    "ingest": "tsx src/ingest/main.ts",
    "ingest:dry": "tsx src/ingest/main.ts --dry",
    "dictionary": "tsx src/extract/build-dictionary.ts",
    "verify:communities": "tsx scripts/verify-communities.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.3.0",
    "@stylexjs/stylex": "^0.19.0",
    "fast-xml-parser": "^4.5.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@astryxdesign/build": "^0.3.0",
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.18.0",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.18.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
